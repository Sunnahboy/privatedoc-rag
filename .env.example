APP_NAME=PrivateDoc RAG
APP_VERSION=0.1.0
ENVIRONMENT=development

MAX_UPLOAD_MB=300
ALLOWED_FILE_EXTENSIONS=.pdf,.txt,.md,.ppt
UPLOAD_DIR=../data/uploads
UPLOAD_CHUNK_SIZE_BYTES=1048576

QDRANT_URL=http://localhost:7000
OLLAMA_URL=http://localhost:11434

DATABASE_URL=sqlite+aiosqlite:///./privatedoc.db
DATABASE_ECHO=false

EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=llama3.1

PDF_OCR_DPI=72
PDF_OCR_MAX_CONCURRENT=2
MIN_DIGITAL_TEXT_WORDS=15
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=2

# Retrieval & Reranker
RRF_K=60
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_ENABLED=true